{
  "name": "ytora",
  "version": "1.0.0",
  "description": "Standalone YouTube and YouTube Music downloader with Innertube extraction, cipher resolution, PoToken generation, SABR/HLS streaming, and automatic ffmpeg-static muxing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./clients": {
      "types": "./dist/clients/index.d.ts",
      "import": "./dist/clients/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "bin": {
    "ytora": "./bin/ytora.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "keywords": [
    "ytora",
    "youtube",
    "youtube-downloader",
    "youtube-music",
    "innertube",
    "sabr",
    "hls",
    "ffmpeg",
    "ffmpeg-static"
  ],
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "start": "node --dns-result-order=ipv4first bin/ytora.js",
    "download": "node --dns-result-order=ipv4first bin/ytora.js",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^7.0.2"
  }
}
